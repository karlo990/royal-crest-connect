<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http:// is allowed so the app can reach a server running on the
     school office PC (e.g. http://192.168.1.20:8000). The setup screen only
     accepts http:// for addresses on the local network; anything on the
     internet must be https://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
