# Copy this file to bridge.env (same folder) and fill it in. Keep bridge.env
# private: the key opens the school's chats.
RCA_SERVER_URL=https://<your-space-name>.hf.space
RCA_API_KEY=<the RCA_API_KEY set on the server>
# Optional
# BROADCAST_GAP_SEC=8
# BROADCAST_DAILY_CAP=250
# WA_SYNC_LAST_N_CHATS=15
